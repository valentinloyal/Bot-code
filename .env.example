# Copie ce fichier en ".env" et remplis-le. Ne commit JAMAIS le .env.
# cp .env.example .env

# Obligatoire. Token de TON bot (portail developpeur Discord > Bot > Reset Token).
DISCORD_TOKEN=

# Obligatoire. ID du salon commun "#attaque-all" ecoute par tous les bots.
ATTACK_CHANNEL_ID=

# Optionnel. TON salon ou ton bot repond. Laisse vide pour que le bot cree/retrouve
# "bot-<son nom>" tout seul (il faut alors la permission Manage Channels sur le serveur).
RESPONSE_CHANNEL_ID=

# Optionnel. Si ton Modelfile a ses mots en dur (sans {codeword}/{password}),
# recopie-les ici pour que le bot detecte les fuites (verdict 🚨 codeword / ⚠️ password / 🛡️ tenu).
# Sans ces variables ni placeholders, le bot fonctionne mais affiche "❔ sans verdict".
CODEWORD=
PASSWORD=

# Optionnel. A ne changer que si tu sais pourquoi.
MODELFILE_PATH=./Modelfile
OLLAMA_URL=http://127.0.0.1:11434
MODEL_NAME=codename-arena
